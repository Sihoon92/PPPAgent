# Shell scripts must keep LF endings so they run under WSL/Linux
*.sh text eol=lf

# Python entrypoints are executed directly via their shebang
*.py text eol=lf

# Windows batch files need CRLF
*.cmd text eol=crlf

# .env is sourced by bash inside WSL; CR would end up in the values
.env*    text eol=lf
