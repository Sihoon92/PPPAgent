# Project-local settings. Copy to .env and edit; .env is gitignored.
# scripts/devshell.sh exports everything in here before activating the venv,
# so these values override the defaults it would otherwise pick.

# ── LLM ────────────────────────────────────────────────────────────────
# These three are enough for the template path (pptagent-mcp) and take
# priority over CONFIG_FILE — see pptagent/mcp_server.py:70.
# The full agent path (`pptagent generate`) still needs config.yaml.
#PPTAGENT_MODEL=qwen2.5:14b
#PPTAGENT_API_BASE=http://127.0.0.1:11434/v1
#PPTAGENT_API_KEY=ollama

# ── config.yaml location ───────────────────────────────────────────────
# Defaults to ~/.config/deeppresenter/config.yaml. Point it at a file inside
# the repo if you would rather edit it here.
#CONFIG_FILE=/mnt/c/path/to/PPTAgent/config.local.yaml

# ── Office mode (Windows PowerPoint bridge) ────────────────────────────
# devshell.sh turns this on by default. Set to 0 to disable.
#PPTAGENT_OFFICE_MODE=1
# Windows python with pywin32. Unset = found via PATH.
#PPTAGENT_WIN_PYTHON=/mnt/c/Users/you/anaconda3/python.exe
# Staging dir; must be under a drive mount, not WSL's /tmp.
#PPTAGENT_WIN_TEMP=/mnt/c/Users/Public
